# Production settings for the VPS. Create the real file on the server with:
#   bash deploy/scripts/init-env.sh
# which copies this template to deploy/.env, generates strong secrets and asks for your domains.
# NEVER commit deploy/.env and never paste its values into chat.

# --- Public addresses (DNS A records must point to the server's IP) ---
# e.g. app.example.com / n8n.example.com, or for testing without a domain: app.203-0-113-10.sslip.io
APP_DOMAIN=
N8N_DOMAIN=
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=

# --- App ---
LOG_LEVEL=info
APP_TIMEZONE=Asia/Kolkata
ADMIN_API_TOKEN=
JOB_WORKER_ENABLED=true
JOB_MAX_ATTEMPTS=3

# --- PostgreSQL ---
POSTGRES_USER=qgm
POSTGRES_DB=qgm
POSTGRES_PASSWORD=

# --- n8n ---
N8N_VERSION=2.48.4
N8N_DB_PASSWORD=
# Encrypts credentials stored in n8n. Keep a safe copy: without it, saved n8n credentials are lost.
N8N_ENCRYPTION_KEY=

# --- Backups (deploy/scripts/backup.sh) ---
BACKUP_DIR=/var/backups/qgm
BACKUP_RETENTION_DAYS=14

# --- OpenAI (scripts + illustrations) - paste the key yourself with: nano deploy/.env ---
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6.2-sol
OPENAI_IMAGE_MODEL=gpt-image-2.6-flare
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_HOOK_QUALITY=high
OPENAI_IMAGE_SIZE=1008x1792
OPENAI_IMAGE_CONCURRENCY=2
OPENAI_MAX_USD_PER_RUN=2

# --- ElevenLabs (voice) - paste the key yourself with: nano deploy/.env ---
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_MAX_USD_PER_RUN=0.5

# --- Blotato (publishing) - paste the key yourself; generating a key starts Blotato billing ---
BLOTATO_API_KEY=
BLOTATO_YOUTUBE_PRIVACY=private

# --- Daily automation (docs/publishing.md "Full automation") ---
# Brands that get videos every day (comma-separated ids, or "all").
AUTOMATION_BRANDS=quiet-growth,behtar-bano,ninnu-nuvvu-geluvu
# The 06:00 run makes videos this many days ahead (1 = tomorrow).
SCHEDULE_LEAD_DAYS=1
# Network-wide AI spend cap per day in USD; paid steps wait for the next day once it is reached.
DAILY_MAX_USD=3
# final = publishable videos (needs the brand voices on a paid ElevenLabs plan); test = labelled test videos.
PIPELINE_RENDER_MODE=final
# Switch on only after the social accounts are linked (npm run blotato:link) and checked.
PUBLISHING_ENABLED=false
