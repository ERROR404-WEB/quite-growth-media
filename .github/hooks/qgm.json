{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/session-context.mjs",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/guard.mjs",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/format-on-edit.mjs",
        "timeoutSec": 30
      }
    ]
  }
}
