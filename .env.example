# Copy to .env with:  npm run setup:env   (generates strong random secrets for you)
# NEVER commit .env. NEVER paste real keys into chat, issues or source code.

# --- App ---
NODE_ENV=development
# 0.0.0.0 lets the n8n Docker container reach the API through host.docker.internal.
# Mutating API routes still require ADMIN_API_TOKEN.
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
APP_TIMEZONE=Asia/Kolkata
# Token required for POST /api/* routes (n8n sends it as "Authorization: Bearer <token>").
ADMIN_API_TOKEN=

# --- Job worker ---
JOB_WORKER_ENABLED=true
JOB_POLL_INTERVAL_MS=2000
JOB_MAX_ATTEMPTS=3
JOB_STALE_LOCK_MINUTES=15

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=qgm
POSTGRES_PASSWORD=
POSTGRES_DB=qgm
POSTGRES_PORT=5433
DATABASE_URL=postgres://qgm:${POSTGRES_PASSWORD}@127.0.0.1:5433/qgm
TEST_DATABASE_URL=postgres://qgm:${POSTGRES_PASSWORD}@127.0.0.1:5433/qgm_test

# --- n8n (docker compose) ---
N8N_VERSION=stable
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
QGM_API_BASE_URL=http://host.docker.internal:3000

# --- Media rendering ---
# Optional: full paths if ffmpeg/ffprobe are not on PATH (winget installs are found automatically).
# FFMPEG_PATH=
# FFPROBE_PATH=

# --- OpenAI (scripts + illustrations) ---
# Paste your key after the = sign yourself, in your editor. Never share it in chat or commit it.
OPENAI_API_KEY=
# Models and settings (prices checked 18 Nov 2026 - see src/ai/pricing.ts).
OPENAI_TEXT_MODEL=gpt-6.2-sol
OPENAI_IMAGE_MODEL=gpt-image-2.6-flare
# low | medium | high | xhigh | max - higher costs more per image.
OPENAI_IMAGE_QUALITY=medium
# Quality of the first (hook) image only - it decides whether viewers stop scrolling.
OPENAI_IMAGE_HOOK_QUALITY=high
# 9:16, multiples of 16. Falls back to 1024x1536 (cropped) if the model rejects it.
OPENAI_IMAGE_SIZE=1008x1792
# Hard stop per test/video run, in USD.
OPENAI_MAX_USD_PER_RUN=2
OPENAI_IMAGE_CONCURRENCY=2

# --- ElevenLabs (voice) ---
# Paste your key after the = sign yourself. Never share it in chat or commit it.
ELEVENLABS_API_KEY=
# eleven_v4 supports English, Hindi AND Telugu (multilingual_v2 / flash_v2_5 have no Telugu).
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
# Hard stop per test run for voice, in USD.
ELEVENLABS_MAX_USD_PER_RUN=0.5
# Each brand's fixed voice lives in src/brands/definitions/<brand>.ts (voice.elevenLabs).
# Optional overrides: ELEVENLABS_VOICE_<BRAND_ID>=<voice id>, e.g. ELEVENLABS_VOICE_CHINNI_LOKAM=...
# Optional fallbacks per language: ELEVENLABS_VOICE_EN= / ELEVENLABS_VOICE_HI= / ELEVENLABS_VOICE_TE=

# --- Blotato (publishing, docs/publishing.md) ---
# Paste your key after the = sign yourself. Never share it in chat or commit it.
# Generating the key in Blotato ends the free trial and starts the paid plan.
BLOTATO_API_KEY=
# Visibility of new YouTube uploads: private (default, check first posts) | unlisted | public
BLOTATO_YOUTUBE_PRIVACY=private

# --- Daily automation (docs/publishing.md "Full automation") ---
# Brands that get videos every day (comma-separated ids, or "all").
AUTOMATION_BRANDS=quiet-growth,behtar-bano,ninnu-nuvvu-geluvu
# The 06:00 run makes videos this many days ahead (1 = tomorrow, leaves time for retries).
SCHEDULE_LEAD_DAYS=1
# Network-wide AI spend cap per day in USD (APP_TIMEZONE); paid steps wait for the next day.
DAILY_MAX_USD=3
# final = publishable (brand voice on a paid ElevenLabs plan) | test = labelled test videos, never published.
PIPELINE_RENDER_MODE=final
# Storyboards, images and renders made by the worker.
PIPELINE_DATA_DIR=data/pipeline
# Automatic publishing (also needs BLOTATO_API_KEY). Leave false until the accounts are linked and checked.
PUBLISHING_ENABLED=false
