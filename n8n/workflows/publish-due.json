{
  "id": "qgmPublishDue001",
  "name": "QGM - Publish due videos",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/10 * * * *"
            }
          ]
        }
      },
      "id": "7a1c2d3e-0001-4b52-8c4f-000000000001",
      "name": "Every 10 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {},
      "id": "7a1c2d3e-0002-4b52-8c4f-000000000002",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "apiBaseUrl",
              "value": "http://127.0.0.1:3000",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "7a1c2d3e-0003-4b52-8c4f-000000000003",
      "name": "Config (edit API URL here)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 100],
      "notes": "Native n8n: http://127.0.0.1:3000 | n8n in Docker Desktop: http://host.docker.internal:3000 | VPS compose: http://api:3000"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBaseUrl }}/api/publish/due",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "7a1c2d3e-0004-4b52-8c4f-000000000004",
      "name": "Enqueue due publications",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 100],
      "credentials": {
        "httpHeaderAuth": {
          "id": "qgmAdminToken001",
          "name": "QGM Admin Token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Only triggers the API. The API decides what is due, runs the publishing gate and posts each video at most once. Does nothing until PUBLISHING_ENABLED=true and BLOTATO_API_KEY are set."
    }
  ],
  "connections": {
    "Every 10 minutes": {
      "main": [[{ "node": "Config (edit API URL here)", "type": "main", "index": 0 }]]
    },
    "Run manually": {
      "main": [[{ "node": "Config (edit API URL here)", "type": "main", "index": 0 }]]
    },
    "Config (edit API URL here)": {
      "main": [[{ "node": "Enqueue due publications", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
